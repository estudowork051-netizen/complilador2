; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for now you can edit it as you like.

config_version=5

[application]

config/name="Guardians of the Last Base"
config/description="Tower Defense RPG with defender heroes, active abilities and base progression."
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.0666667, 0.0823529, 0.129412, 1)
config/icon="res://assets/icons/icon.svg"

[autoload]

GameStateManager="*res://scripts/managers/game_state_manager.gd"
SaveManager="*res://scripts/managers/save_manager.gd"
ProgressionManager="*res://scripts/managers/progression_manager.gd"
AudioManager="*res://scripts/managers/audio_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/resizable=true
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0666667, 0.0823529, 0.129412, 1)
