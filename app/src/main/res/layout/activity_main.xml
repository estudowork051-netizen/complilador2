<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_fantasy"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Fantasy Crest Emblem -->
        <ImageView
            android:id="@+id/imgEmblem"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_shield_crest"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title: Heroes Tower Defense -->
        <TextView
            android:id="@+id/tvGameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:text="@string/app_name"
            android:textColor="@color/gold_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgEmblem" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/app_subtitle"
            android:textColor="@color/text_gold"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGameTitle" />

        <!-- Player Status Bar Card (Moedas e Nível da Base) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPlayerStatusBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/fantasy_bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_inner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <!-- Coins -->
                <TextView
                    android:id="@+id/tvPlayerCoins"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💰 300 Moedas"
                    android:textColor="@color/gold_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Base Level -->
                <TextView
                    android:id="@+id/tvBaseLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_badge"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="🏰 Base: Nv 1"
                    android:textColor="@color/gold_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Menu Action Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/fantasy_bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardPreventCornerOverlap="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPlayerStatusBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. JOGAR Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPlay"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/btn_fantasy_gold"
                    android:drawableStart="@drawable/ic_play_arrow"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_play"
                    android:textColor="#0B0F19"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 2. HERÓIS Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHeroes"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_fantasy_blue"
                    android:drawableStart="@drawable/ic_heroes"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_heroes"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 3. FASES Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStages"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_fantasy_blue"
                    android:drawableStart="@drawable/ic_map_stages"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_stages"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 4. LOJA Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnShop"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_fantasy_blue"
                    android:drawableStart="@drawable/ic_shop"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_shop"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 5. CONFIGURAÇÕES Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSettings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_fantasy_blue"
                    android:drawableStart="@drawable/ic_settings_gear"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_settings"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 6. SAIR Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnExit"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_fantasy_crimson"
                    android:drawableStart="@drawable/ic_exit_door"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_exit"
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Version Footer -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_version_label"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardMenu"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
