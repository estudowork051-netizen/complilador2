<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_fantasy">

    <!-- Primary Gameplay Screen Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top HUD Bar -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTopHud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fantasy_bg_card"
            app:cardCornerRadius="0dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- Base Health Indicator -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Vida da Base"
                    android:src="@drawable/ic_heart" />

                <TextView
                    android:id="@+id/tvHudLives"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="20 / 20"
                    android:textColor="@color/crimson_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Wave Counter -->
                <TextView
                    android:id="@+id/tvHudWave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Onda: 1 / 5"
                    android:textColor="@color/gold_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Remaining Enemies in Wave -->
                <TextView
                    android:id="@+id/tvHudEnemies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Inimigos: 5"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Towers Built Counter -->
                <TextView
                    android:id="@+id/tvHudTowers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="Torres: 0/5"
                    android:textColor="@color/text_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Pause Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPause"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_fantasy_blue"
                    android:drawableStart="@drawable/ic_pause"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/btn_pause"
                    android:textColor="@color/text_title"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Boss Battle Dedicated Top HUD Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBossHud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#1E1B4B"
            app:cardCornerRadius="8dp"
            app:cardElevation="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardTopHud">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBossHudName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GOLEM DE OBSIDIANA"
                        android:textColor="@color/gold_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBossHudPhase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_badge"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="FASE 1"
                        android:textColor="#F59E0B"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBossHudHealth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vida: 900 / 900 (100%)"
                        android:textColor="@color/crimson_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBossWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Ataque Iminente!"
                        android:textColor="#F43F5E"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2D Canvas Map View -->
        <com.heroes.towerdefense.game.view.StageOneCanvasView
            android:id="@+id/canvasGameMap"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/cardBuildPanel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardTopHud" />

        <!-- Bottom Tower Construction / Selection Panel -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBuildPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/fantasy_bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp"
            app:layout_constraintBottom_toTopOf="@id/cardHeroSkills"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_fantasy"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Container 1: Construct New Tower -->
                <LinearLayout
                    android:id="@+id/layoutConstructTower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvBuildPanelTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/build_panel_title"
                            android:textColor="@color/gold_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Cancel Build Button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnCancelBuild"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/btn_fantasy_crimson"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_cancel_build"
                            android:textColor="@color/text_title"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBuildPanelSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/build_panel_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <!-- 3 Tower Choice Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Archer Tower Button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnBuildArcher"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_fantasy_blue"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/build_btn_archer"
                            android:textColor="@color/text_title"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Mage Tower Button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnBuildMage"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_fantasy_gold"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/build_btn_mage"
                            android:textColor="#0B0F19"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Cannon Tower Button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnBuildCannon"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_fantasy_crimson"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/build_btn_cannon"
                            android:textColor="@color/text_title"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Container 2: Built Tower Details -->
                <LinearLayout
                    android:id="@+id/layoutTowerDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTowerInfoTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tower_info_title"
                            android:textColor="@color/gold_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnCloseTowerInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/btn_fantasy_blue"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_close_tower_info"
                            android:textColor="@color/text_title"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTowerInfoStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Torre de Arqueiros • Dano: 18 • Alcance: Médio"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Persistent Bottom Hero Skills HUD (Part 5) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHeroSkills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fantasy_bg_card"
            app:cardCornerRadius="0dp"
            app:cardElevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_fantasy"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <!-- Hero Info / Badge -->
                <LinearLayout
                    android:id="@+id/layoutHeroBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tvHeroHudName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kael"
                        android:textColor="@color/gold_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroHudRarity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMUM"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Skill 1 Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHeroSkill1"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_fantasy_gold"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Golpe Flamejante\nPRONTO"
                    android:textColor="@color/text_title"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Skill 2 Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnHeroSkill2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_fantasy_crimson"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Onda de Fogo\nPRONTO"
                    android:textColor="@color/text_title"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- PAUSE OVERLAY (Modal) -->
    <FrameLayout
        android:id="@+id/layoutPauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD0B0F19"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            app:cardBackgroundColor="@color/fantasy_bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_fantasy"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_pause" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pause_title"
                    android:textColor="@color/gold_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/pause_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- CONTINUAR Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnResume"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_fantasy_gold"
                    android:drawableStart="@drawable/ic_play_arrow"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_resume"
                    android:textColor="#0B0F19"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- REINICIAR FASE Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRestartFromPause"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_fantasy_blue"
                    android:drawableStart="@drawable/ic_restart"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_restart"
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- VOLTAR AO MENU Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnExitFromPause"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_fantasy_crimson"
                    android:drawableStart="@drawable/ic_exit_door"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_back_to_menu"
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- VICTORY OVERLAY (Modal) -->
    <FrameLayout
        android:id="@+id/layoutVictoryOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE0B0F19"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="@color/fantasy_bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_fantasy"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_trophy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/victory_title"
                    android:textColor="@color/gold_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/victory_subtitle"
                    android:textColor="@color/text_gold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/victory_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Match Summary Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_inner"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/victory_summary_waves"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVictorySummaryHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Vida final da base: 20 / 20"
                        android:textColor="#34D399"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVictorySummaryReward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Recompensa: +150 moedas"
                        android:textColor="@color/gold_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- JOGAR NOVAMENTE Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPlayAgain"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_fantasy_gold"
                    android:drawableStart="@drawable/ic_play_arrow"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_play_again"
                    android:textColor="#0B0F19"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- VOLTAR AO MENU Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnExitFromVictory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_fantasy_blue"
                    android:drawableStart="@drawable/ic_back_arrow"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_back_to_menu"
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- DEFEAT OVERLAY (Modal) -->
    <FrameLayout
        android:id="@+id/layoutDefeatOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE0B0F19"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="@color/fantasy_bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_fantasy"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_skull" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/defeat_title"
                    android:textColor="@color/crimson_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/defeat_subtitle"
                    android:textColor="@color/text_gold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/defeat_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Match Summary Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_inner"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvDefeatSummaryWave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ondas alcançadas: 1 de 5"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Vida da base: 0 / 20 (Destruída)"
                        android:textColor="@color/crimson_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- TENTAR NOVAMENTE Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTryAgain"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_fantasy_gold"
                    android:drawableStart="@drawable/ic_restart"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_try_again"
                    android:textColor="#0B0F19"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- VOLTAR AO MENU Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnExitFromDefeat"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_fantasy_crimson"
                    android:drawableStart="@drawable/ic_exit_door"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_back_to_menu"
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- Boss Cinematic Entrance Modal Overlay -->
    <FrameLayout
        android:id="@+id/layoutBossIntroOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D0050811"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="@color/fantasy_bg_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_fantasy"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvBossIntroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="⚔️ ALERTA DE CHEFÃO ⚔️"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Boss Animated Portrait Avatar View -->
                <com.heroes.towerdefense.game.view.EnemyAvatarView
                    android:id="@+id/viewBossIntroAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvBossIntroName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="GOLEM DE OBSIDIANA"
                    android:textColor="@color/gold_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBossIntroSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Colosso da Terra e Fogo"
                    android:textColor="@color/text_gold"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/tvBossIntroDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Um tremor vulcânico ecoa! O Golem de Obsidiana desperta das profundezas!"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- PULAR APRESENTAÇÃO Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSkipBossIntro"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_fantasy_gold"
                    android:gravity="center"
                    android:text="PULAR APRESENTAÇÃO ⏭️"
                    android:textColor="#0B0F19"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</FrameLayout>
