<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.HeroesTowerDefense">

        <!-- 1. Main Menu Screen -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Match Preparation Screen -->
        <activity
            android:name=".ui.preparation.StagePreparationActivity"
            android:exported="false"
            android:label="@string/stage_prep_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:screenOrientation="portrait" />

        <!-- 3. Gameplay Arena Screen (Provisional Stage 1) -->
        <activity
            android:name=".ui.stage.StageOneActivity"
            android:exported="false"
            android:label="@string/stage_one_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:screenOrientation="portrait" />

        <!-- 4. Campaign Stages Selection Screen -->
        <activity
            android:name=".ui.stages.StageSelectActivity"
            android:exported="false"
            android:label="@string/stages_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:screenOrientation="portrait" />

        <!-- 5. Heroes Collection Screen -->
        <activity
            android:name=".ui.heroes.HeroesActivity"
            android:exported="false"
            android:label="@string/heroes_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:screenOrientation="portrait" />

        <!-- 6. Shop Screen -->
        <activity
            android:name=".ui.shop.ShopActivity"
            android:exported="false"
            android:label="@string/shop_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:screenOrientation="portrait" />

        <!-- 7. Settings Screen -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:screenOrientation="portrait" />

    </application>

</manifest>
