    <!-- 1. Kael -->
    <string name="hero_kael_name">Kael</string>
    <string name="hero_kael_title">Cavaleiro do Fogo</string>
    <string name="hero_kael_class">Classe: Guerreiro de Vanguarda</string>
    <string name="hero_kael_stats">Vida: 550 | Dano: 45 | Vel. Ataque: 1.2/s | DPS: 54.0</string>
    <string name="hero_kael_skill1_name">1. Golpe Flamejante (Recarga: 6s | Dano: 120)</string>
    <string name="hero_kael_skill1_desc">Golpe concentrado com lâmina em chamas que causa alto dano ígneo a um invasor.</string>
    <string name="hero_kael_skill2_name">2. Onda de Fogo (Recarga: 12s | Dano: 80 em Área)</string>
    <string name="hero_kael_skill2_desc">Libera um anel ardente expansivo causando dano ígneo em área a todos os inimigos ao redor.</string>

    <!-- 2. Lyra -->
    <string name="hero_lyra_name">Lyra</string>
    <string name="hero_lyra_title">Sentinela dos Bosques</string>
    <string name="hero_lyra_class">Classe: Arqueira de Precisão</string>
    <string name="hero_lyra_stats">Vida: 420 | Dano: 40 | Vel. Ataque: 1.5/s | DPS: 75.0</string>
    <string name="hero_lyra_skill1_name">1. Tiro de Precisão (Recarga: 7s | Dano: 140)</string>
    <string name="hero_lyra_skill1_desc">Dispara uma flecha veloz perfurante de longo alcance com alto dano de impacto.</string>
    <string name="hero_lyra_skill2_name">2. Chuva de Flechas (Recarga: 14s | Dano: 95 em Área)</string>
    <string name="hero_lyra_skill2_desc">Faz chover uma saraivada de flechas místicas em uma zona da trilha, punindo múltiplos goblins.</string>

    <!-- 3. Brakk -->
    <string name="hero_brakk_name">Brakk</string>
    <string name="hero_brakk_title">Guardião das Montanhas</string>
    <string name="hero_brakk_class">Classe: Bárbaro Defensor</string>
    <string name="hero_brakk_stats">Vida: 750 | Dano: 50 | Vel. Ataque: 0.9/s | DPS: 67.5</string>
    <string name="hero_brakk_skill1_name">1. Pancada Terrestre (Recarga: 8s | Dano: 110 em Área)</string>
    <string name="hero_brakk_skill1_desc">Bate com a maça no solo gerando uma onda de choque sísmica devastadora em área.</string>
    <string name="hero_brakk_skill2_name">2. Fortificação Protetora (Recarga: 18s | +2 Vidas)</string>
    <string name="hero_brakk_skill2_desc">Ergue escudos pétreos ancestrais, restaurando 2 pontos de integridade da fortaleza.</string>

    <!-- 4. Nyra -->
    <string name="hero_nyra_name">Nyra</string>
    <string name="hero_nyra_title">Arquimaga da Tempestade</string>
    <string name="hero_nyra_class">Classe: Feiticeira Elemental</string>
    <string name="hero_nyra_stats">Vida: 400 | Dano: 60 | Vel. Ataque: 1.4/s | DPS: 126.0</string>
    <string name="hero_nyra_skill1_name">1. Ataque Sombrio (Recarga: 6.5s | Dano: 170)</string>
    <string name="hero_nyra_skill1_desc">Desfere um golpe sombrio súbito que atinge o invasor prioritário com dano fulminante.</string>
    <string name="hero_nyra_skill2_name">2. Dança das Lâminas (Recarga: 11s | Dano: 115 em Área)</string>
    <string name="hero_nyra_skill2_desc">Invoca lâminas de energia sombria rotativa que fustigam todos os inimigos na área.</string>

    <!-- 5. Tiko -->
    <string name="hero_tiko_name">Tiko</string>
    <string name="hero_tiko_title">Artífice Alquimista</string>
    <string name="hero_tiko_class">Classe: Mestre de Armadilhas</string>
    <string name="hero_tiko_stats">Vida: 460 | Dano: 42 | Vel. Ataque: 1.1/s | DPS: 85.5</string>
    <string name="hero_tiko_skill1_name">1. Mina de Fragmentação (Recarga: 8s | Dano: 130 em Área)</string>
    <string name="hero_tiko_skill1_desc">Detona um artefato de estilhaços mecânicos atingindo múltiplos invasores no caminho.</string>
    <string name="hero_tiko_skill2_name">2. Engenho Explosivo (Recarga: 15s | Dano: 160 em Área)</string>
    <string name="hero_tiko_skill2_desc">Arremessa um mecanismo incendiário de alta potência causando explosão devastadora em grande área.</string>

    <!-- 6. Vesper -->
    <string name="hero_vesper_name">Vesper</string>
    <string name="hero_vesper_title">Caçadora Espectral</string>
    <string name="hero_vesper_class">Classe: Assassina das Sombras</string>
    <string name="hero_vesper_stats">Vida: 440 | Dano: 65 | Vel. Ataque: 1.0/s | DPS: 146.2</string>
    <string name="hero_vesper_skill1_name">1. Cometa Astral (Recarga: 7.5s | Dano: 190)</string>
    <string name="hero_vesper_skill1_desc">Canaliza um projétil cósmico veloz de matéria estelar causando destruição maciça a um alvo.</string>
    <string name="hero_vesper_skill2_name">2. Singularidade Cósmica (Recarga: 16s | Dano: 150 em Área)</string>
    <string name="hero_vesper_skill2_desc">Abre um vórtice estelar supermassivo que aprisiona e consome toda a horda de goblins na área.</string>

