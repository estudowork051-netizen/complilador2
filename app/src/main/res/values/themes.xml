<resources>
    <!-- Base application theme. -->
    <style name="Theme.HeroesTowerDefense" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorPrimaryVariant">@color/gold_dark</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/emerald_primary</item>
        <item name="colorSecondaryVariant">@color/emerald_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/fantasy_bg_dark</item>
        <item name="android:colorBackground">@color/fantasy_bg_dark</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/fantasy_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
